# Copy to .dev.vars (git-ignored) for `pnpm dev`.
# The web dev server proxies /api to this Worker, so Better Auth's public URL is the dev server's.
AUTH_BASE_URL=http://localhost:5173/api/auth
# Any random string of 32+ characters, e.g. from `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# A GitHub OAuth app for local use, with the callback URL
# http://localhost:5173/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Where `pnpm dev` serves the play Worker (dev in wrangler.play.jsonc). Not localhost, which shares
# the web dev server's cookies.
PLAY_ORIGIN=http://127.0.0.1:8788
# Who may sign in comes from `vars.ALLOWED_GITHUB_USER_IDS` in wrangler.jsonc. To sign in locally
# as someone else, set your numeric GitHub user ID (`gh api user -q .id`) here, comma-separated.
# ALLOWED_GITHUB_USER_IDS=
