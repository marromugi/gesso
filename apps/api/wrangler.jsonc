{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gesso-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  // Not every command reads this (wrangler 4.160 ignores it in `types` and autoconfig).
  // Run wrangler through the package.json scripts, which also set WRANGLER_SEND_METRICS=false.
  "send_metrics": false,
  // No public URL: the web Worker (apps/web/wrangler.jsonc) reaches it through a service binding.
  "workers_dev": false,
  "preview_urls": false,
  "dev": {
    "port": 8787,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gesso",
      "database_id": "abd44e69-70a3-4246-9cb5-13bfd80302a2",
      "migrations_dir": "migrations",
    },
  ],
  // Prototype files by content, under `prototypes/<prototypeId>/<sha-256>` (src/prototypes).
  "r2_buckets": [{ "binding": "PROTOTYPE_FILES", "bucket_name": "gesso-prototype-files" }],
  // Per client IP, for POST /auth/sign-in/* and /auth/device/code (src/app.ts).
  "ratelimits": [
    {
      "name": "SIGN_IN_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "vars": {
    // Better Auth's public URL: the web Worker's origin plus `/api/auth`. Local dev overrides it in
    // .dev.vars (see .dev.vars.example).
    "AUTH_BASE_URL": "https://gesso-web.marrromugi-dev.workers.dev/api/auth",
    // GitHub's numeric user IDs allowed to sign in, comma-separated (101984097 is marromugi).
    // Anyone else is refused before a user is made.
    "ALLOWED_GITHUB_USER_IDS": "101984097",
    // Where the play Worker (wrangler.play.jsonc) serves versions; play URLs point here. Local dev
    // overrides it in .dev.vars.
    "PLAY_ORIGIN": "https://gesso-play.marrromugi-dev.workers.dev",
  },
  // Set with `wrangler secret put` for production and in .dev.vars locally.
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
