{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gesso-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  // Not every command reads this (wrangler 4.160 ignores it in `types` and autoconfig).
  // Run wrangler through the package.json scripts, which also set WRANGLER_SEND_METRICS=false.
  "send_metrics": false,
  // No public URL: the web Worker (apps/web/wrangler.jsonc) reaches it through a service binding.
  "workers_dev": false,
  "preview_urls": false,
  "dev": {
    "port": 8787,
  },
  "d1_databases": [{ "binding": "DB", "database_name": "gesso", "migrations_dir": "migrations" }],
  // Per client IP, for POST /auth/sign-in/* (src/app.ts).
  "ratelimits": [
    {
      "name": "SIGN_IN_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "vars": {
    // Better Auth's public URL: the web Worker's origin plus `/api/auth`. Local dev overrides it in
    // .dev.vars (see .dev.vars.example).
    "AUTH_BASE_URL": "https://gesso-web.marrromugi-dev.workers.dev/api/auth",
  },
  // Set with `wrangler secret put` for production and in .dev.vars locally.
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
