{
  "name": "@gesso/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p . && tsc -p tsconfig.node.json",
    "codegen": "orval && msw init",
    "storybook": "storybook dev --port 6006 --ci --no-version-updates",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@gesso/api": "workspace:*",
    "@storybook/react-vite": "^10.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "msw": "^3.0.4",
    "msw-storybook-addon": "^3.0.3",
    "orval": "^8.47.0",
    "storybook": "^10.6.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
