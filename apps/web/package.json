{
  "name": "@gesso/web",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "WRANGLER_SEND_METRICS=false wrangler types",
    "dev": "vite",
    "build": "vite build && WRANGLER_SEND_METRICS=false wrangler deploy --dry-run",
    "deploy": "WRANGLER_SEND_METRICS=false wrangler deploy",
    "typecheck": "WRANGLER_SEND_METRICS=false wrangler types && tsc -p . && tsc -p tsconfig.node.json && tsc -p worker",
    "codegen": "orval && msw init && tsr generate",
    "storybook": "storybook dev --port 6006 --ci --no-version-updates",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@gesso/api": "workspace:*",
    "@storybook/react-vite": "^10.6.7",
    "@tanstack/router-cli": "^1.168.0",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "msw": "^3.0.4",
    "msw-storybook-addon": "^3.0.3",
    "orval": "^8.47.0",
    "storybook": "^10.6.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "wrangler": "^4.160.0"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
