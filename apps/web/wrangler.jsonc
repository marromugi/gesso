{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gesso-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  // Not every command reads this. Run wrangler through the package.json scripts, which also set
  // WRANGLER_SEND_METRICS=false.
  "send_metrics": false,
  // Only the workers.dev URL is public; no per-version preview URLs.
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Only API calls reach the Worker; every other path is the SPA.
    "run_worker_first": ["/api/*"],
  },
  "services": [{ "binding": "API", "service": "gesso-api" }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
