{
  "$schema": "./node_modules/turbo/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["codegen"],
      "outputs": []
    },
    "openapi": {
      "outputs": ["openapi.json"]
    },
    "codegen": {
      "dependsOn": ["^openapi"],
      "outputs": ["src/lib/api/generated/**"]
    },
    "dev": {
      "dependsOn": ["codegen"],
      "cache": false,
      "persistent": true
    }
  }
}
