{
  "$schema": "./node_modules/turbo/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["codegen"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["codegen"],
      "outputs": []
    },
    "openapi": {
      "outputs": ["openapi.json"]
    },
    "codegen": {
      "dependsOn": ["^openapi"],
      "outputs": [
        "src/generated/**",
        "src/lib/api/generated/**",
        "src/lib/apiMocks/generated/**",
        ".storybook/public/mockServiceWorker.js",
        "src/routeTree.gen.ts"
      ]
    },
    "build-storybook": {
      "dependsOn": ["codegen"],
      "outputs": ["storybook-static/**"]
    },
    "deploy": {
      "dependsOn": ["build", "^deploy"],
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["codegen"],
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "dependsOn": ["codegen"],
      "cache": false,
      "persistent": true
    }
  }
}
