{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "outputs": ["worker-configuration.d.ts"]
    },
    "openapi": {
      "outputs": ["openapi.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
